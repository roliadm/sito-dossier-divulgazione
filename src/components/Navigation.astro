---
const navItems = [
    { name: "Home", href: "/" },
    { name: "Assistenza", href: "/assistenza-informatica-roma" },
    { name: "Servizi", href: "/servizi" },
    { name: "Articoli", href: "/articoli" },
    { name: "Chi Sono", href: "/chi-sono" },
    { name: "Contatti", href: "/contatti" },
];
---

<nav
    class="fixed top-6 left-1/2 -translate-x-1/2 z-50 w-full max-w-[90%] sm:max-w-fit transition-all duration-300"
>
    <div
        class="bg-white/70 backdrop-blur-xl border border-white/60 rounded-full px-6 py-3 shadow-2xl shadow-blue-900/5 flex items-center justify-between sm:justify-center gap-4 sm:gap-8"
    >
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group shrink-0">
            <div
                class="w-8 h-8 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center text-white font-bold text-xs group-hover:scale-110 transition-transform shadow-lg shadow-blue-500/30"
            >
                RL
            </div>
            <span
                class="font-bold text-slate-800 tracking-tight hidden sm:block group-hover:text-blue-600 transition-colors"
                >Rocco Ligorio</span
            >
        </a>

        <!-- Desktop Links -->
        <div class="hidden md:flex items-center gap-1">
            <a
                href="/"
                class="nav-link px-4 py-2 rounded-full text-sm font-medium text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 transition-all relative group"
            >
                Home
            </a>
            <a
                href="/assistenza-informatica-roma"
                class="nav-link px-4 py-2 rounded-full text-sm font-medium text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 transition-all"
            >
                Assistenza
            </a>
            <a
                href="/siti-web"
                class="nav-link px-4 py-2 rounded-full text-sm font-medium text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 transition-all"
            >
                Siti Web
            </a>
            <a
                href="/laboratorio"
                class="nav-link px-4 py-2 rounded-full text-sm font-medium text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 transition-all"
            >
                Strumenti
            </a>
            <a
                href="/news"
                class="nav-link px-4 py-2 rounded-full text-sm font-medium text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 transition-all"
            >
                News
            </a>
        </div>

        <!-- CTA & Mobile Menu Toggle -->
        <div class="flex items-center gap-3">
            <a
                href="/contatti"
                class="hidden sm:flex px-5 py-2 bg-slate-900 text-white text-sm font-bold rounded-full hover:bg-slate-800 transition-colors shadow-lg hover:shadow-xl hover:-translate-y-0.5"
            >
                Contattami
            </a>

            <!-- Mobile Menu Button -->
            <button
                id="mobile-menu-btn"
                class="md:hidden p-2 text-slate-600 hover:text-blue-600 hover:bg-blue-50 rounded-full transition-colors"
                aria-label="Menu"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 6h16M4 12h16m-7 6h7"></path>
                </svg>
            </button>
        </div>
    </div>

    <!-- Mobile Menu Dropdown (Glass Light) -->
    <div
        id="mobile-menu"
        class="absolute top-full left-0 w-full mt-4 p-4 rounded-2xl bg-white/90 backdrop-blur-2xl border border-white/60 shadow-2xl shadow-blue-900/10 opacity-0 invisible transform -translate-y-2 transition-all duration-300 origin-top"
    >
        <div class="flex flex-col gap-2 relative z-50">
            <a
                href="/"
                class="p-3 text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 rounded-xl transition-colors font-medium"
                >Home</a
            >
            <a
                href="/assistenza-informatica-roma"
                class="p-3 text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 rounded-xl transition-colors font-medium"
                >Assistenza</a
            >
            <a
                href="/siti-web"
                class="p-3 text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 rounded-xl transition-colors font-medium"
                >Siti Web</a
            >
            <a
                href="/laboratorio"
                class="p-3 text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 rounded-xl transition-colors font-medium"
                >Strumenti</a
            >
            <a
                href="/news"
                class="p-3 text-slate-600 hover:text-blue-700 hover:bg-blue-50/50 rounded-xl transition-colors font-medium"
                >News</a
            >
            <a
                href="/contatti"
                class="p-3 text-center bg-blue-600 text-white font-bold rounded-xl mt-2 shadow-lg"
                >Contattami</a
            >
        </div>
    </div>
</nav>

<script>
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");

    if (btn && menu) {
        btn.addEventListener("click", (e) => {
            e.stopPropagation(); // Stop propagation
            const isClosed = menu.classList.contains("invisible");
            if (isClosed) {
                menu.classList.remove(
                    "invisible",
                    "opacity-0",
                    "-translate-y-2",
                );
            } else {
                menu.classList.add("invisible", "opacity-0", "-translate-y-2");
            }
        });

        // Close on click outside
        document.addEventListener("click", (e) => {
            if (
                !menu.classList.contains("invisible") &&
                !menu.contains(e.target as Node) &&
                !btn.contains(e.target as Node)
            ) {
                menu.classList.add("invisible", "opacity-0", "-translate-y-2");
            }
        });
    }
</script>
