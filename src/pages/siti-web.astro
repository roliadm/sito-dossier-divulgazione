---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

// Placeholder data - user can ask to update this list later
const friends = [
    {
        name: "Ferruzzi Informatica",
        url: "https://www.ferruzziinformatica.it",
        desc: "Soluzioni informatiche per aziende, assistenza tecnica e noleggio operativo.",
        icon: "🖥️",
    },
    {
        name: "Divulgazione Libera",
        url: "https://www.divulgazionelibera.it",
        desc: "Portale di informazione indipendente e condivisione libera della conoscenza.",
        icon: "📢",
    },
    {
        name: "Gentiluomo Digitale",
        url: "https://www.gentiluomodigitale.it",
        desc: "Riflessioni su tecnologia, etica e buone maniere nell'era digitale.",
        icon: "🎩",
    },
    {
        name: "Marco Nica",
        url: "https://www.marconica.it",
        desc: "Sito ufficiale di Marco Nica, autore e regista teatrale, dove racconta il suo percorso artistico tra scrittura, teatro ed eventi culturali.",
        icon: "🎭",
    },
    {
        name: "HTML.it",
        url: "https://www.html.it",
        desc: "Storico portale italiano su sviluppo web e programmazione.",
        icon: "💻",
    },
    {
        name: "Aranzulla.it",
        url: "https://www.aranzulla.it",
        desc: "Supporto tecnico divulgativo e guide pratiche per tutti.",
        icon: "🆘",
    },
    {
        name: "TechPrincess",
        url: "https://techprincess.it",
        desc: "News tech, app e mondo digitale.",
        icon: "👸",
    },
    {
        name: "GitHub",
        url: "https://github.com",
        desc: "Progetti open source e repository di codice.",
        icon: "🐙",
    },
    {
        name: "Stack Overflow",
        url: "https://stackoverflow.com",
        desc: "Community globale per sviluppatori e risoluzione problemi coding.",
        icon: "📚",
    },
    {
        name: "Wired Italia",
        url: "https://www.wired.it",
        desc: "Copertura a 360° su tecnologia, innovazione, cultura digitale e trend tech.",
        icon: "🗞️",
    },
    {
        name: "HDblog",
        url: "https://www.hdblog.it",
        desc: "Recensioni, news su hardware, smartphone, software e tecnologia.",
        icon: "📱",
    },
    {
        name: "Hardware Upgrade",
        url: "https://www.hwupgrade.it",
        desc: "Storico sito italiano sul mondo informatico e hardware.",
        icon: "🖥️",
    },
    {
        name: "Tom's Hardware Italia",
        url: "https://www.tomshw.it",
        desc: "Guide hardware, recensioni e consigli pratici per PC e gaming.",
        icon: "🔧",
    },
    {
        name: "Macitynet",
        url: "https://www.macitynet.it",
        desc: "Riferimento per il mondo Apple, software e compatibilità.",
        icon: "🍎",
    },
    {
        name: "MIT Technology Review",
        url: "https://www.technologyreview.it",
        desc: "Approfondimenti su innovazione, tendenze tech avanzate e IA.",
        icon: "🤖",
    },
    {
        name: "TechnBLOG",
        url: "https://www.technblog.it",
        desc: "Blog su gadget, smartphone e tech consumer.",
        icon: "🔌",
    },
    {
        name: "Digital4",
        url: "https://www.digital4.biz",
        desc: "Informazione B2B su trasformazione digitale e innovazione per le aziende.",
        icon: "💼",
    },
    {
        name: "StartupItalia",
        url: "https://startupitalia.eu",
        desc: "Innovazione, startup e digital transformation in Italia.",
        icon: "🚀",
    },
];

const features = [
    {
        title: "Siti Web Vetrina",
        desc: "Presenta la tua attività con un design moderno, veloce e ottimizzato per tutti i dispositivi.",
        icon: "🌐",
    },
    {
        title: "E-Commerce",
        desc: "Vendi i tuoi prodotti online con piattaforme sicure e facili da gestire.",
        icon: "🛍️",
    },
    {
        title: "Applicazioni Web",
        desc: "Soluzioni su misura per gestire processi aziendali complessi direttamente dal browser.",
        icon: "💻",
    },
    {
        title: "SEO & Performance",
        desc: "Ottimizzazione per i motori di ricerca e velocità di caricamento per scalare le classifiche.",
        icon: "🚀",
    },
];
---

<Layout
    title="Sviluppo Siti Web & Partner - Rocco Andrea Ligorio"
    description="Creazione siti web professionali, e-commerce e applicazioni web. Scopri anche i nostri partner tecnologici."
>
    <Navigation />

    <main class="w-full pt-24 pb-12">
        <!-- Hero Section -->
        <section
            class="max-w-7xl mx-auto px-4 text-center mb-24 animate-fade-in-up"
        >
            <h1 class="text-5xl md:text-6xl font-bold text-slate-900 mb-6">
                Costruiamo il tuo <br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600"
                    >Spazio Digitale</span
                >
            </h1>
            <p class="text-xl text-slate-600 max-w-2xl mx-auto mb-10">
                Soluzioni web moderne, performanti e su misura. Dall'idea alla
                messa online, ti guido in ogni passo della tua presenza
                digitale.
            </p>
            <a
                href="/contatti"
                class="px-8 py-4 bg-blue-600 text-white font-bold rounded-full shadow-lg hover:shadow-blue-500/30 hover:-translate-y-1 transition-all inline-flex items-center gap-2"
            >
                Inizia il Progetto 🚀
            </a>
        </section>

        <!-- Services Grid -->
        <section
            class="max-w-7xl mx-auto px-4 mb-32 animate-fade-in-up delay-100"
        >
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
                {
                    features.map((feature) => (
                        <div class="card-ceramic p-8 hover:bg-white/80">
                            <div class="text-4xl mb-4">{feature.icon}</div>
                            <h3 class="text-xl font-bold text-slate-900 mb-2">
                                {feature.title}
                            </h3>
                            <p class="text-slate-600 text-sm leading-relaxed">
                                {feature.desc}
                            </p>
                        </div>
                    ))
                }
            </div>
        </section>

        <!-- Separator -->
        <div
            class="w-full h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent mb-24"
        >
        </div>

        <!-- Friends Section -->
        <section
            class="max-w-6xl mx-auto px-4 animate-fade-in-up delay-200"
            id="siti-amici"
        >
            <div class="text-center mb-16">
                <span
                    class="text-blue-600 font-bold uppercase tracking-widest text-sm mb-2 block"
                    >Network</span
                >
                <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">
                    Siti Amici & Risorse
                </h2>
                <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                    Una selezione curata di partner tecnologici, portali di
                    informazione e strumenti utili che consiglio.
                </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {
                    friends.map((friend) => (
                        <a
                            href={friend.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group card-ceramic p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 no-underline flex flex-col h-full"
                        >
                            <div class="flex items-start justify-between mb-4">
                                <span class="text-3xl bg-blue-50 w-12 h-12 flex items-center justify-center rounded-xl group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300">
                                    {friend.icon}
                                </span>
                                <span class="text-slate-300 group-hover:text-blue-600 transition-colors">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-5 w-5"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                        />
                                    </svg>
                                </span>
                            </div>

                            <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 mb-2 transition-colors">
                                {friend.name}
                            </h3>
                            <p class="text-slate-500 text-sm flex-grow">
                                {friend.desc}
                            </p>
                        </a>
                    ))
                }
            </div>

            <!-- Call for collaboration -->
            <div
                class="mt-16 text-center bg-blue-50/50 rounded-2xl p-8 border border-blue-100"
            >
                <p class="text-slate-600 mb-4 font-medium">
                    Hai un progetto interessante o vuoi apparire in questa
                    lista?
                </p>
                <a
                    href="/contatti"
                    class="text-blue-600 font-bold hover:underline inline-flex items-center gap-1"
                    >Contattami per una partnership <span aria-hidden="true"
                        >&rarr;</span
                    ></a
                >
            </div>
        </section>
    </main>

    <Footer />
</Layout>
