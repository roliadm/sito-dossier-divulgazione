---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import AnimatedFlask from "../components/AnimatedFlask.astro"; // Keep for blog section aesthetic
import { getCollection } from "astro:content";

// Fetch latest articles for authority/blog section
const allArticles = await getCollection("articoli", ({ data }) => {
    if (import.meta.env.PROD) {
        return data.draft !== true && data.date <= new Date();
    }
    return true;
});
const sortedArticles = allArticles.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
    title="Tecnico Informatico a Roma | Assistenza PC e Supporto IT"
    description="Assistenza informatica professionale a Roma e Lazio. Rocco Andrea Ligorio: tecnico IT per privati e piccole aziende. Risoluzione problemi PC, Reti, Sicurezza."
>
    <Navigation />

    <main class="w-full">
        <!-- HERO SECTION -->
        <!-- HERO SECTION -->
        <section
            class="relative bg-paper text-slate-900 py-32 md:py-48 overflow-hidden"
        >
            <!-- Animated Liquid Light Background -->
            <div class="absolute inset-0 z-0">
                <div
                    class="absolute top-[-50%] left-[-50%] w-[200%] h-[200%] animate-aurora opacity-60 blur-[100px]"
                    style="background: conic-gradient(from 0deg at 50% 50%, #eff6ff 0deg, #bfdbfe 60deg, #e9d5ff 120deg, #fbcfe8 180deg, #e9d5ff 240deg, #eff6ff 360deg);"
                >
                </div>
            </div>

            <!-- Grid Pattern Overlay -->
            <div
                class="absolute inset-0 z-0 bg-[url('/grid-pattern.svg')] opacity-[0.03] mix-blend-darken"
            >
            </div>

            <div class="max-w-7xl mx-auto px-4 relative z-10 text-center">
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/40 border border-slate-200 backdrop-blur-md mb-8 hover:bg-white/60 transition-colors animate-fade-in-up shadow-sm"
                >
                    <span class="relative flex h-3 w-3">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                        ></span>
                        <span
                            class="relative inline-flex rounded-full h-3 w-3 bg-green-500"
                        ></span>
                    </span>
                    <span
                        class="text-xs font-bold uppercase tracking-widest text-blue-600"
                    >
                        System Online · Roma & Remoto
                    </span>
                </div>

                <h1
                    class="text-6xl md:text-8xl font-bold mb-8 leading-tight animate-fade-in-up delay-100 font-sans tracking-tight text-slate-900"
                >
                    Informatica <br />
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 typing-container"
                        >Avanguardia Pura</span
                    >
                </h1>

                <p
                    class="text-xl md:text-2xl text-slate-600 mb-12 max-w-2xl mx-auto animate-fade-in-up delay-200 leading-relaxed font-light"
                >
                    Rocco Andrea Ligorio. <span
                        class="text-slate-900 font-medium"
                        >Tecnico Enterprise.</span
                    ><br />
                    Soluzioni radicali per problemi complessi.
                </p>

                <div
                    class="flex flex-col sm:flex-row gap-6 justify-center animate-fade-in-up delay-300"
                >
                    <a
                        href="/assistenza-informatica-roma"
                        class="px-8 py-5 bg-blue-600 text-white font-bold rounded-2xl shadow-xl shadow-blue-500/20 hover:shadow-blue-500/40 hover:-translate-y-1 transition-all text-lg flex items-center justify-center gap-3 btn-shimmer group"
                    >
                        <span>🛠️ Servizi Premium</span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5 group-hover:translate-x-1 transition-transform"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
                        >
                    </a>
                    <a
                        href="/contatti"
                        class="px-8 py-5 bg-white/60 backdrop-blur-md border border-white/50 text-slate-700 font-bold rounded-2xl hover:bg-white/80 transition-all text-lg flex items-center justify-center gap-3 group shadow-lg shadow-slate-200/50"
                    >
                        <span>✉️ Contatto Diretto</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- SOCIAL PROOF / TESTIMONIALS -->
        <section class="py-12 bg-white border-b border-slate-100">
            <div class="max-w-7xl mx-auto px-4">
                <div class="grid md:grid-cols-3 gap-8">
                    <!-- Review 1 -->
                    <div class="flex flex-col items-center text-center">
                        <div class="flex text-amber-400 mb-3 text-lg">
                            ★★★★★
                        </div>
                        <p class="text-slate-600 italic mb-4">
                            "Quando il server dello studio si è bloccato, Rocco
                            è intervenuto subito. Dati recuperati e giornata
                            salvata."
                        </p>
                        <p class="font-bold text-slate-900 text-sm">
                            Marco T., Commercialista
                        </p>
                    </div>
                    <!-- Review 2 -->
                    <div
                        class="flex flex-col items-center text-center md:border-x md:border-slate-100 md:px-4"
                    >
                        <div class="flex text-amber-400 mb-3 text-lg">
                            ★★★★★
                        </div>
                        <p class="text-slate-600 italic mb-4">
                            "Problema PEC risolto via remoto in 15 minuti mentre
                            ero in pausa pranzo. Efficienza rara a Roma."
                        </p>
                        <p class="font-bold text-slate-900 text-sm">
                            Elena B., Architetto
                        </p>
                    </div>
                    <!-- Review 3 -->
                    <div class="flex flex-col items-center text-center">
                        <div class="flex text-amber-400 mb-3 text-lg">
                            ★★★★★
                        </div>
                        <p class="text-slate-600 italic mb-4">
                            "Ha configurato rete e backup automatico. Finalmente
                            dormo sonni tranquilli per i dati dei clienti."
                        </p>
                        <p class="font-bold text-slate-900 text-sm">
                            Stefano R., Amministratore
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- PROBLEMS SOLVED SECTION (Cards) -->
        <section class="py-20 bg-slate-50">
            <div class="max-w-7xl mx-auto px-4">
                <h2
                    class="text-3xl md:text-4xl font-bold text-center text-slate-900 mb-16"
                >
                    Problemi Reali, Soluzioni Concrete
                </h2>

                <div class="grid md:grid-cols-3 gap-8">
                    <!-- Card 1 -->
                    <a
                        href="/pc-lento-windows-11"
                        class="group bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all no-underline"
                    >
                        <div
                            class="w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            🐌
                        </div>
                        <h3
                            class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600"
                        >
                            PC Lento Windows 11
                        </h3>
                        <p class="text-slate-600 mb-4">
                            Il computer è diventato inutilizzabile?
                            Ottimizzazione profonda senza formattare
                            inutilmente.
                        </p>
                        <span
                            class="text-sm font-bold text-blue-600 flex items-center gap-1"
                        >
                            Diagnosi e Soluzione <span
                                class="group-hover:translate-x-1 transition-transform"
                                >→</span
                            >
                        </span>
                    </a>

                    <!-- Card 2 -->
                    <a
                        href="/wifi-lento-casa-ufficio"
                        class="group bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all no-underline"
                    >
                        <div
                            class="w-14 h-14 bg-indigo-50 rounded-xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            📡
                        </div>
                        <h3
                            class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600"
                        >
                            WiFi e Reti
                        </h3>
                        <p class="text-slate-600 mb-4">
                            Connessione che cade o non copre tutte le stanze?
                            Analisi interferenze e reti Mesh.
                        </p>
                        <span
                            class="text-sm font-bold text-blue-600 flex items-center gap-1"
                        >
                            Migliora la Rete <span
                                class="group-hover:translate-x-1 transition-transform"
                                >→</span
                            >
                        </span>
                    </a>

                    <!-- Card 3 -->
                    <a
                        href="/pc-non-si-avvia"
                        class="group bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all no-underline"
                    >
                        <div
                            class="w-14 h-14 bg-red-50 rounded-xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            💻
                        </div>
                        <h3
                            class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600"
                        >
                            PC Non Si Avvia
                        </h3>
                        <p class="text-slate-600 mb-4">
                            Schermo nero, BSoD o alimentatore guasto.
                            Diagnostica hardware e recupero operatività.
                        </p>
                        <span
                            class="text-sm font-bold text-blue-600 flex items-center gap-1"
                        >
                            Recupero PC <span
                                class="group-hover:translate-x-1 transition-transform"
                                >→</span
                            >
                        </span>
                    </a>

                    <!-- Card 4 -->
                    <a
                        href="/certificato-https-non-valido"
                        class="group bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all no-underline"
                    >
                        <div
                            class="w-14 h-14 bg-emerald-50 rounded-xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            🔒
                        </div>
                        <h3
                            class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600"
                        >
                            Sicurezza & Privacy
                        </h3>
                        <p class="text-slate-600 mb-4">
                            Errori certificati HTTPS, virus, o configurazioni
                            browser compromesse.
                        </p>
                        <span
                            class="text-sm font-bold text-blue-600 flex items-center gap-1"
                        >
                            Naviga Sicuro <span
                                class="group-hover:translate-x-1 transition-transform"
                                >→</span
                            >
                        </span>
                    </a>

                    <!-- Card 5 -->
                    <a
                        href="/errore-windows-update"
                        class="group bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all no-underline"
                    >
                        <div
                            class="w-14 h-14 bg-amber-50 rounded-xl flex items-center justify-center text-3xl mb-6 group-hover:scale-110 transition-transform"
                        >
                            🔄
                        </div>
                        <h3
                            class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600"
                        >
                            Windows Update
                        </h3>
                        <p class="text-slate-600 mb-4">
                            Aggiornamenti bloccati che rallentano il pc? Reset
                            componenti e fix definitivo.
                        </p>
                        <span
                            class="text-sm font-bold text-blue-600 flex items-center gap-1"
                        >
                            Sblocca Update <span
                                class="group-hover:translate-x-1 transition-transform"
                                >→</span
                            >
                        </span>
                    </a>

                    <!-- Card 6 -->
                    <div
                        class="bg-gradient-to-br from-slate-900 to-slate-800 p-8 rounded-2xl shadow-sm border border-slate-700 text-white flex flex-col justify-center text-center"
                    >
                        <h3 class="text-xl font-bold mb-4">
                            Hai un altro problema?
                        </h3>
                        <p class="text-slate-300 mb-6">
                            Non tutti i guasti sono standard. Parliamo del tuo
                            caso specifico.
                        </p>
                        <a
                            href="/contatti"
                            class="inline-block bg-white text-slate-900 font-bold py-3 px-6 rounded-lg hover:bg-blue-50 mx-auto transition-colors"
                        >
                            Contattami
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ABOUT / AUTHORITY -->
        <section class="py-20 bg-white">
            <div
                class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center gap-16"
            >
                <div class="w-full md:w-1/2">
                    <div class="relative">
                        <div
                            class="absolute inset-0 bg-blue-600 transform translate-x-4 translate-y-4 rounded-2xl opacity-20"
                        >
                        </div>
                        <!-- Placeholder for photo if user adds one later, using logo or generic for now if no photo -->
                        <div
                            class="relative bg-slate-100 rounded-2xl p-8 border border-slate-200 aspect-video flex items-center justify-center"
                        >
                            <span class="text-6xl">👨‍💻</span>
                        </div>
                    </div>
                </div>
                <div class="w-full md:w-1/2">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-slate-900 mb-6"
                    >
                        Chi sono e come lavoro
                    </h2>
                    <div class="prose prose-lg text-slate-600">
                        <p>
                            Sono <strong>Rocco Andrea Ligorio</strong>. A
                            differenza dei tanti "amici che se ne intendono",
                            porto un'esperienza maturata in anni di <strong
                                >Help Desk e supporto IT aziendale</strong
                            >.
                        </p>
                        <p>Cosa significa per te?</p>
                        <ul class="list-disc pl-4 space-y-2">
                            <li>Niente tentativi a caso: diagnosi precisa.</li>
                            <li>
                                Rispetto dei tuoi dati: procedure di backup
                                prima di ogni intervento rischioso.
                            </li>
                            <li>
                                Trasparenza: ti spiego cosa è successo in parole
                                semplici.
                            </li>
                        </ul>
                        <div class="mt-8">
                            <a
                                href="/chi-sono"
                                class="text-blue-600 font-bold hover:text-blue-800 underline decoration-2 decoration-blue-200 hover:decoration-blue-600 transition-all"
                            >
                                Scopri la mia storia professionale →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- LATEST ARTICLES (Authority Boost) -->
        <section class="py-20 bg-slate-50 border-t border-slate-200">
            <div class="max-w-7xl mx-auto px-4">
                <div class="flex justify-between items-end mb-12">
                    <div>
                        <h2 class="text-3xl font-bold text-slate-900 mb-2">
                            Guide e Divulgazione
                        </h2>
                        <p class="text-slate-600">
                            Articoli tecnici e approfondimenti dal mio blog.
                        </p>
                    </div>
                    <a
                        href="/articoli"
                        class="hidden md:inline-block font-bold text-blue-600 hover:text-blue-800"
                        >Tutti gli articoli →</a
                    >
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {
                        sortedArticles
                            .slice(0, 3)
                            .map((article: any, index) => {
                                // Keep functionality from old implementation
                                const colorNames = [
                                    "blue",
                                    "emerald",
                                    "violet",
                                ] as const;
                                const colorName =
                                    colorNames[index % colorNames.length];

                                const colors = [
                                    {
                                        border: "hover:border-blue-400",
                                        text: "group-hover:text-blue-600",
                                    },
                                    {
                                        border: "hover:border-emerald-400",
                                        text: "group-hover:text-emerald-600",
                                    },
                                    {
                                        border: "hover:border-violet-400",
                                        text: "group-hover:text-violet-600",
                                    },
                                ];
                                const color = colors[index % colors.length];

                                return (
                                    <article
                                        class={`bg-white rounded-xl border border-slate-200 p-8 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-[300px] justify-between text-center group relative ${color.border}`}
                                    >
                                        <div class="mt-2 transition-transform duration-300 group-hover:scale-110">
                                            <AnimatedFlask
                                                color={colorName}
                                                class="w-16 h-16 mx-auto"
                                            />
                                        </div>
                                        <h3
                                            class={`font-bold text-xl text-slate-800 transition-colors duration-300 break-words w-full px-2 ${color.text}`}
                                        >
                                            {article.data.title}
                                        </h3>
                                        <p class="font-medium text-xs text-slate-400 uppercase tracking-wider mb-2">
                                            {article.data.date.toLocaleDateString(
                                                "it-IT",
                                                {
                                                    day: "numeric",
                                                    month: "long",
                                                    year: "numeric",
                                                },
                                            )}
                                        </p>
                                        <a
                                            href={`/articoli/${article.slug}`}
                                            class="absolute inset-0 z-10"
                                            aria-label={`Leggi ${article.data.title}`}
                                        />
                                    </article>
                                );
                            })
                    }
                </div>
                <div class="mt-8 text-center md:hidden">
                    <a
                        href="/articoli"
                        class="font-bold text-blue-600 hover:text-blue-800"
                        >Tutti gli articoli →</a
                    >
                </div>
            </div>
        </section>

        <!-- FOOTER -->
        <Footer />
    </main>
</Layout>
